# Copy to .env.local for local dev, and set in Vercel → Settings → Environment Variables
# Get your API key at https://resend.com/api-keys (sign up with your Gmail)

# Required — without this, contact submissions return "not configured"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Ask Talha assistant (optional) — free key from https://aistudio.google.com/apikey
# Without it, the chatbot still works using the built-in knowledge engine.
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.0-flash, falls back to gemini-1.5-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional overrides (sane defaults are built into the route)
# CONTACT_TO_EMAIL=iamtalhaqureshi849@gmail.com
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>