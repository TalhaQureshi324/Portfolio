# Copy to .env.local for local dev, and set in Vercel → Settings → Environment Variables

# Contact form — get a key at https://resend.com/api-keys
# Without this, contact submissions return "not configured".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Ask Talha assistant — Gemini is the PRIMARY provider (streamed SSE).
# Free key: https://aistudio.google.com/apikey  (never use NEXT_PUBLIC_*)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.7-flash

# Ask Talha FALLBACK provider — called only when Gemini fails or is unset.
# GLM_API_KEY=
# Optional overrides (defaults: glm-4.6 @ https://api.z.ai/api/paas/v4)
# GLM_MODEL=glm-4.6
# GLM_BASE_URL=https://api.z.ai/api/paas/v4

# With no AI key at all, the chat endpoint answers honestly that it is
# temporarily unavailable — there are no canned answers.

# Contact form overrides (sane defaults built into the route)
# CONTACT_TO_EMAIL=iamtalhaqureshi849@gmail.com
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
