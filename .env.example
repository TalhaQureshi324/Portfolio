# Copy to .env.local for local dev, and set in Vercel → Settings → Environment Variables

# Contact form — get a key at https://resend.com/api-keys
# Without this, contact submissions return "not configured".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Ask Talha assistant — Kimi (Moonshot) is the PRIMARY LLM, raced in
# parallel with GLM; the first to return a valid token wins, the loser
# is cancelled. If both fail, local portfolio reasoning answers.
# Get a Kimi key at https://platform.moonshot.ai  (server-side only —
# never use NEXT_PUBLIC_* for any key)
KIMI_API_KEY=
# Optional overrides (defaults: kimi-k2-turbo-preview @ https://api.moonshot.ai/v1)
# KIMI_MODEL=kimi-k2-turbo-preview
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# GLM (Z.ai) — parallel provider / fallback in the race.
# GLM_API_KEY=
# Optional overrides (defaults: glm-4.6 @ https://api.z.ai/api/paas/v4)
# GLM_MODEL=glm-4.6
# GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Per-provider first-token timeout, milliseconds (default 10000 each;
# both run CONCURRENTLY, so worst-case wait ≈ one provider timeout)
# KIMI_TIMEOUT_MS=10000
# GLM_TIMEOUT_MS=10000

# With no AI keys at all, the chatbot answers from local portfolio
# reasoning — the page content is the foundation, LLMs are enhancements.

# Contact form overrides (sane defaults built into the route)
# CONTACT_TO_EMAIL=iamtalhaqureshi849@gmail.com
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
